{
  "name": "deeptutor-enterprise-frontends",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:oms": "npm run dev --workspace @deeptutor/oms-prototype",
    "dev:tms": "npm run dev --workspace @deeptutor/tms-prototype",
    "build:oms": "npm run build --workspace @deeptutor/oms-prototype",
    "build:tms": "npm run build --workspace @deeptutor/tms-prototype",
    "typecheck:oms": "npm run typecheck --workspace @deeptutor/oms-prototype",
    "typecheck:tms": "npm run typecheck --workspace @deeptutor/tms-prototype",
    "lint": "eslint apps packages tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^25",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.3",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
