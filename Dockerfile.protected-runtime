# ============================================
# DeepTutor protected release runtime assembler
# ============================================
# This Dockerfile is used by Woodpecker protected K8s releases after the
# runtime base, frontend bundle, and Python dependency tree have already been
# built in parallel artifact-image steps. It only assembles the final runtime
# image, preserving the same production runtime layout as Dockerfile without
# running apt, npm, pip, rustup, or cargo in this final stage.
# ============================================

ARG RUNTIME_BASE_IMAGE=python:3.11-slim
ARG FRONTEND_ARTIFACT_IMAGE=node:22-slim
ARG PYTHON_DEPS_IMAGE=python:3.11-slim

# The external stages are immutable images pushed by parallel steps in the same
# release pipeline.
FROM ${FRONTEND_ARTIFACT_IMAGE} AS frontend-artifact
FROM ${PYTHON_DEPS_IMAGE} AS python-deps
FROM ${RUNTIME_BASE_IMAGE} AS production

# 与本地通用镜像区分；缺部署配置或改写 ASGI 入口时禁止启动核心管理面。
ENV DEEPTUTOR_PROTECTED_RUNTIME=1

LABEL maintainer="DeepTutor Team" \
      description="DeepTutor: AI-Powered Personalized Learning Assistant"

WORKDIR /app

# Runtime process config and startup scripts are tracked files, not heredoc RUN
# commands, so Kaniko can assemble the final image without repeatedly taking a
# full filesystem snapshot after large artifact copies.
COPY deploy/docker-runtime/supervisord.conf /etc/supervisor/supervisord.conf
COPY deploy/docker-runtime/programs.conf /etc/supervisor/conf.d/programs.conf
COPY deploy/docker-runtime/start-backend.sh /app/start-backend.sh
COPY deploy/docker-runtime/start-frontend.sh /app/start-frontend.sh
COPY deploy/docker-runtime/entrypoint.sh /app/entrypoint.sh
COPY deploy/docker-runtime/healthcheck.py /app/healthcheck.py

# Copy Python packages produced by the parallel compile-python-deps image.
COPY --from=python-deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=python-deps /usr/local/bin /usr/local/bin

# Copy frontend artifacts produced by the parallel compile-frontend image.
# The standalone output contains a self-contained server.js + minimal node_modules;
# static assets and public/ must be copied alongside standalone manually.
COPY --from=frontend-artifact --chown=deeptutor:deeptutor /app/web/.next/standalone/ ./web/
COPY --from=frontend-artifact --chown=deeptutor:deeptutor /app/web/.next/static/ ./web/.next/static/
COPY --from=frontend-artifact --chown=deeptutor:deeptutor /app/web/public/ ./web/public/

# Copy application source code.
COPY deeptutor/ ./deeptutor/
COPY deeptutor_cli/ ./deeptutor_cli/
COPY extensions/enterprise/src/deeptutor_enterprise/ ./extensions/enterprise/src/deeptutor_enterprise/
COPY scripts/ ./scripts/
COPY pyproject.toml ./
COPY requirements/ ./requirements/
COPY requirements.txt ./

# Expose ports.
EXPOSE 8001 3782

# Health check. Read the port from JSON so standalone `docker run` does not
# depend on a Dockerfile-level BACKEND_PORT default.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python /app/healthcheck.py

ENTRYPOINT ["/app/entrypoint.sh"]
